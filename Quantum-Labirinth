<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quantum Labyrinth - CTF Challenge</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Courier New', monospace;
            background: #0a0a0a;
            color: #00ff00;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(0, 255, 0, 0.1) 0%, transparent 50%),
                linear-gradient(to bottom, #0a0a0a, #1a1a1a);
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            width: 100%;
            padding: 2rem;
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid #00ff00;
            border-radius: 10px;
            box-shadow: 0 0 50px rgba(0, 255, 0, 0.1);
        }
        
        h1 {
            text-align: center;
            margin-bottom: 2rem;
            font-size: 2.5rem;
            text-shadow: 0 0 20px rgba(0, 255, 0, 0.3);
            letter-spacing: 5px;
        }
        
        .challenge-area {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .patterns-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        .pattern-card {
            background: #1a1a1a;
            border: 2px solid #333;
            border-radius: 8px;
            padding: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            position: relative;
        }
        
        .pattern-card:hover {
            border-color: #00ff00;
            transform: scale(1.02);
        }
        
        .pattern-card.selected {
            border-color: #00ff00;
            background: rgba(0, 255, 0, 0.1);
        }
        
        .pattern-card canvas {
            width: 100%;
            max-width: 150px;
            height: auto;
            margin: 0 auto;
            display: block;
            background: white;
        }
        
        .pattern-label {
            margin-top: 0.5rem;
            color: #888;
            font-size: 0.9rem;
        }
        
        .riddle-section {
            background: #1a1a1a;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #333;
        }
        
        .riddle-section h3 {
            color: #00ff00;
            margin-bottom: 1rem;
        }
        
        .riddle-list {
            list-style: none;
            padding: 0;
        }
        
        .riddle-list li {
            padding: 0.5rem 0;
            border-bottom: 1px solid #333;
            color: #ccc;
            font-style: italic;
        }
        
        .controls {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .btn {
            background: transparent;
            color: #00ff00;
            border: 2px solid #00ff00;
            padding: 0.75rem 2rem;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
            font-family: 'Courier New', monospace;
            transition: all 0.3s ease;
        }
        
        .btn:hover {
            background: #00ff00;
            color: #0a0a0a;
        }
        
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .status {
            text-align: center;
            margin-top: 1.5rem;
            padding: 1rem;
            border: 1px solid #333;
            border-radius: 5px;
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        
        .flag-progress {
            margin-top: 1rem;
            text-align: center;
        }
        
        .flag-parts {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }
        
        .flag-part {
            background: #1a1a1a;
            padding: 0.25rem 0.5rem;
            border: 1px solid #333;
            border-radius: 3px;
            color: #888;
            font-size: 0.9rem;
        }
        
        .flag-part.collected {
            border-color: #00ff00;
            color: #00ff00;
            background: rgba(0, 255, 0, 0.1);
        }
        
        .flag-part.placeholder {
            border-color: #666;
            color: #666;
            opacity: 0.5;
        }
        
        .timer {
            text-align: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: #ff6b6b;
        }
        
        .full-flag {
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(0, 255, 0, 0.1);
            border: 2px solid #00ff00;
            border-radius: 8px;
            font-size: 1.5rem;
            letter-spacing: 2px;
            text-align: center;
            display: none;
        }
        
        .full-flag.show {
            display: block;
        }
        
        @media (max-width: 768px) {
            .challenge-area {
                grid-template-columns: 1fr;
            }
            
            .patterns-grid {
                grid-template-columns: 1fr 1fr;
            }
            
            h1 {
                font-size: 1.8rem;
            }
        }

        .hint-container {
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(255, 255, 0, 0.05);
            border: 1px solid #888;
            border-radius: 5px;
            color: #ffd700;
        }

        .attempts-display {
            text-align: center;
            margin-top: 0.5rem;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>⚡ Quantum Labyrinth ⚡</h1>
        
        <div class="timer" id="timer">⏱️ Time: 60s</div>
        
        <div class="challenge-area">
            <div class="patterns-grid" id="patternsGrid">
                <!-- Patterns generated by JavaScript -->
            </div>
            
            <div class="riddle-section">
                <h3>🔮 The Riddles</h3>
                <ul class="riddle-list" id="riddleList">
                    <li>Loading riddles...</li>
                </ul>
                
                <div class="controls">
                    <button class="btn" id="submitBtn">🔍 Submit Selection</button>
                    <button class="btn" id="refreshBtn">🔄 New Challenge</button>
                </div>
                
                <div class="attempts-display" id="attemptsDisplay">Attempts remaining: 3</div>
                
                <div class="hint-container" id="hintContainer">
                    💡 Select a pattern that matches ALL the hidden rules
                </div>
            </div>
        </div>
        
        <div class="status" id="status">
            Select a pattern and submit your answer
        </div>
        
        <div class="flag-progress">
            <div>Flag Progress:</div>
            <div class="flag-parts" id="flagParts">
                <!-- Flag parts shown here -->
            </div>
            <div class="full-flag" id="fullFlag"></div>
        </div>
    </div>

    <script>
        // === Challenge Logic (All Client-Side) ===
        
        // The flag - hidden in the JavaScript
        const FULL_FLAG = "CTF{hum4n_1ntu1t10n_w1ns_4g41nst_A1}";
        const FLAG_PARTS = ["CTF{", "hum4n_", "1ntu1t10n_", "w1ns_", "4g41nst_", "A1}"];
        
        // State variables
        let selectedPattern = null;
        let timerInterval = null;
        let timeLeft = 60;
        let attempts = 3;
        let collectedParts = [];
        let correctAnswer = 0;
        let challengeSeed = 0;
        let isSolved = false;
        
        // === Pattern Generation ===
        
        function generatePattern(canvas, patternType) {
            const ctx = canvas.getContext('2d');
            const width = canvas.width;
            const height = canvas.height;
            
            // Clear with white background
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, width, height);
            
            // Add random noise to confuse AI
            for (let i = 0; i < 30; i++) {
                const x = Math.random() * width;
                const y = Math.random() * height;
                const gray = 200 + Math.random() * 55;
                ctx.fillStyle = `rgb(${gray}, ${gray}, ${gray})`;
                ctx.fillRect(x, y, 2, 2);
            }
            
            ctx.strokeStyle = 'black';
            ctx.lineWidth = 3;
            
            // Different shapes based on pattern type
            const centerX = width / 2;
            const centerY = height / 2;
            const radius = 60;
            
            if (patternType === 0) {
                // Circle with 7 dots (odd)
                ctx.beginPath();
                ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI);
                ctx.stroke();
                
                // Add 7 dots
                for (let i = 0; i < 7; i++) {
                    const angle = (i * 360 / 7) + (Math.random() * 10 - 5);
                    const x = centerX + radius * 0.8 * Math.cos(angle * Math.PI / 180);
                    const y = centerY + radius * 0.8 * Math.sin(angle * Math.PI / 180);
                    ctx.beginPath();
                    ctx.arc(x, y, 6, 0, 2 * Math.PI);
                    ctx.fillStyle = 'black';
                    ctx.fill();
                }
                
            } else if (patternType === 1) {
                // Square with 8 dots (even)
                const size = 120;
                ctx.strokeRect(centerX - size/2, centerY - size/2, size, size);
                
                // Add 8 dots in a grid pattern
                for (let i = 0; i < 8; i++) {
                    const row = Math.floor(i / 4);
                    const col = i % 4;
                    const x = centerX - size/2 + 20 + col * (size - 40) / 3;
                    const y = centerY - size/2 + 20 + row * (size - 40);
                    ctx.beginPath();
                    ctx.arc(x, y, 6, 0, 2 * Math.PI);
                    ctx.fillStyle = 'black';
                    ctx.fill();
                }
                
            } else if (patternType === 2) {
                // Triangle with 11 dots (prime)
                ctx.beginPath();
                ctx.moveTo(centerX, centerY - radius);
                ctx.lineTo(centerX - radius, centerY + radius * 0.7);
                ctx.lineTo(centerX + radius, centerY + radius * 0.7);
                ctx.closePath();
                ctx.stroke();
                
                // Add 11 dots randomly inside triangle
                for (let i = 0; i < 11; i++) {
                    const x = centerX + (Math.random() - 0.5) * radius * 1.5;
                    const y = centerY + (Math.random() - 0.5) * radius * 1.2;
                    ctx.beginPath();
                    ctx.arc(x, y, 5, 0, 2 * Math.PI);
                    ctx.fillStyle = 'black';
                    ctx.fill();
                }
                
            } else if (patternType === 3) {
                // Irregular shape with 12 dots (composite)
                ctx.beginPath();
                ctx.moveTo(centerX - 30, centerY - 70);
                ctx.lineTo(centerX + 70, centerY - 50);
                ctx.lineTo(centerX + 80, centerY + 60);
                ctx.lineTo(centerX - 40, centerY + 70);
                ctx.closePath();
                ctx.stroke();
                
                // Add 12 dots
                for (let i = 0; i < 12; i++) {
                    const x = centerX + (Math.random() - 0.5) * 100;
                    const y = centerY + (Math.random() - 0.5) * 100;
                    ctx.beginPath();
                    ctx.arc(x, y, 5, 0, 2 * Math.PI);
                    ctx.fillStyle = 'black';
                    ctx.fill();
                }
            }
            
            // Add subtle distortion
            const imageData = ctx.getImageData(0, 0, width, height);
            const data = imageData.data;
            for (let i = 0; i < data.length; i += 4) {
                if (Math.random() < 0.01) {
                    data[i] = Math.random() * 255;
                    data[i+1] = Math.random() * 255;
                    data[i+2] = Math.random() * 255;
                }
            }
            ctx.putImageData(imageData, 0, 0);
        }
        
        // === Challenge Generation ===
        
        function generateChallenge() {
            // Use time-based seed (changes every 5 minutes)
            challengeSeed = Math.floor(Date.now() / 300000);
            const seededRandom = seedRandom(challengeSeed);
            
            // Determine correct answer (0-3)
            correctAnswer = Math.floor(seededRandom() * 4);
            
            // Generate patterns
            const patternsGrid = document.getElementById('patternsGrid');
            patternsGrid.innerHTML = '';
            
            for (let i = 0; i < 4; i++) {
                const card = document.createElement('div');
                card.className = 'pattern-card';
                
                const canvas = document.createElement('canvas');
                canvas.width = 200;
                canvas.height = 200;
                generatePattern(canvas, i);
                
                const label = document.createElement('div');
                label.className = 'pattern-label';
                label.textContent = `Pattern ${i + 1}`;
                
                card.appendChild(canvas);
                card.appendChild(label);
                card.onclick = () => selectPattern(i, card);
                patternsGrid.appendChild(card);
            }
            
            // Generate riddles
            const riddles = [
                "🟠 Pattern 1: 'I have an odd number of dots but I'm not the answer'",
                "🟡 Pattern 2: 'I have an even number and I'm perfectly symmetrical'",
                "🟣 Pattern 3: 'I have a prime number but I'm not the answer'",
                "🔵 Pattern 4: 'I have a composite number and I'm asymmetrical'"
            ];
            
            const riddleList = document.getElementById('riddleList');
            riddleList.innerHTML = '';
            riddles.forEach(riddle => {
                const li = document.createElement('li');
                li.textContent = riddle;
                riddleList.appendChild(li);
            });
            
            // Reset state
            selectedPattern = null;
            document.querySelectorAll('.pattern-card').forEach(card => {
                card.classList.remove('selected');
            });
            
            // Reset attempts if starting fresh
            if (!isSolved) {
                attempts = 3;
                updateAttemptsDisplay();
            }
            
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('hintContainer').textContent = '💡 Select a pattern that matches ALL the hidden rules';
            document.getElementById('status').textContent = 'Select a pattern and submit your answer';
            document.getElementById('status').style.color = '#00ff00';
            
            startTimer();
        }
        
        // === Seeded Random Number Generator ===
        
        function seedRandom(seed) {
            return function() {
                seed = (seed * 9301 + 49297) % 233280;
                return seed / 233280;
            };
        }
        
        // === Pattern Selection ===
        
        function selectPattern(index, element) {
            if (isSolved) return;
            
            document.querySelectorAll('.pattern-card').forEach(card => {
                card.classList.remove('selected');
            });
            element.classList.add('selected');
            selectedPattern = index;
            document.getElementById('status').textContent = `Selected Pattern ${index + 1}`;
            document.getElementById('status').style.color = '#00ff00';
        }
        
        // === Timer ===
        
        function startTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
            }
            
            timeLeft = 60;
            updateTimerDisplay();
            
            timerInterval = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();
                
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    document.getElementById('status').textContent = '⏰ Time is up! Click "New Challenge" to try again.';
                    document.getElementById('status').style.color = '#ff6b6b';
                    document.getElementById('submitBtn').disabled = true;
                }
            }, 1000);
        }
        
        function updateTimerDisplay() {
            const timer = document.getElementById('timer');
            timer.textContent = `⏱️ Time: ${timeLeft}s`;
            if (timeLeft <= 10) {
                timer.style.color = '#ff0000';
            } else {
                timer.style.color = '#ff6b6b';
            }
        }
        
        // === Attempts ===
        
        function updateAttemptsDisplay() {
            document.getElementById('attemptsDisplay').textContent = `Attempts remaining: ${attempts}`;
        }
        
        // === Submit Answer ===
        
        function submitAnswer() {
            if (selectedPattern === null) {
                document.getElementById('status').textContent = '⚠️ Please select a pattern first!';
                document.getElementById('status').style.color = '#ff6b6b';
                return;
            }
            
            if (isSolved) {
                document.getElementById('status').textContent = '🎉 You already solved it! The flag is displayed below.';
                return;
            }
            
            if (attempts <= 0) {
                document.getElementById('status').textContent = '❌ No attempts remaining. Click "New Challenge" to try again.';
                return;
            }
            
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            
            // Check answer
            if (selectedPattern === correctAnswer) {
                // Correct!
                const partIndex = Math.min(collectedParts.length, FLAG_PARTS.length - 1);
                const flagPart = FLAG_PARTS[partIndex];
                collectedParts.push(flagPart);
                
                document.getElementById('status').textContent = `✅ Correct! You earned flag part: ${flagPart}`;
                document.getElementById('status').style.color = '#00ff00';
                
                updateFlagProgress();
                
                if (collectedParts.length === FLAG_PARTS.length) {
                    // Complete!
                    isSolved = true;
                    document.getElementById('fullFlag').textContent = `🏁 ${FULL_FLAG}`;
                    document.getElementById('fullFlag').classList.add('show');
                    document.getElementById('status').textContent = '🎉 Congratulations! You solved the Quantum Labyrinth!';
                    submitBtn.disabled = true;
                    clearInterval(timerInterval);
                } else {
                    // Generate new challenge for next part
                    document.getElementById('hintContainer').textContent = '✅ Correct! Next challenge loading...';
                    setTimeout(() => {
                        generateChallenge();
                        // Keep collected parts
                        updateFlagProgress();
                    }, 2000);
                }
            } else {
                // Wrong
                attempts--;
                updateAttemptsDisplay();
                
                let hint = '';
                if (attempts === 2) {
                    hint = '💡 Hint: Look closely at the number of dots in each pattern...';
                } else if (attempts === 1) {
                    hint = '💡 Hint: One pattern has an even number of dots AND is asymmetrical...';
                } else if (attempts === 0) {
                    hint = '💡 Final hint: Count the dots carefully: 7, 8, 11, 12. Which one is both even and composite?';
                }
                
                document.getElementById('status').textContent = `❌ Incorrect. ${attempts} attempts remaining.`;
                document.getElementById('status').style.color = '#ff6b6b';
                document.getElementById('hintContainer').textContent = hint;
                
                if (attempts <= 0) {
                    document.getElementById('status').textContent = '❌ No attempts left! Click "New Challenge" to try again.';
                    submitBtn.disabled = true;
                } else {
                    submitBtn.disabled = false;
                }
            }
        }
        
        // === Flag Progress ===
        
        function updateFlagProgress() {
            const container = document.getElementById('flagParts');
            container.innerHTML = '';
            
            FLAG_PARTS.forEach((part, index) => {
                const span = document.createElement('span');
                span.className = 'flag-part';
                
                if (index < collectedParts.length) {
                    span.textContent = part;
                    span.classList.add('collected');
                } else {
                    span.textContent = '▢';
                    span.classList.add('placeholder');
                }
                
                container.appendChild(span);
            });
        }
        
        // === Event Listeners ===
        
        document.getElementById('submitBtn').addEventListener('click', submitAnswer);
        document.getElementById('refreshBtn').addEventListener('click', () => {
            if (timerInterval) {
                clearInterval(timerInterval);
            }
            collectedParts = [];
            isSolved = false;
            document.getElementById('fullFlag').classList.remove('show');
            document.getElementById('fullFlag').textContent = '';
            updateFlagProgress();
            generateChallenge();
        });
        
        // === Initialize ===
        
        generateChallenge();
        updateFlagProgress();
    </script>
</body>
</html>
